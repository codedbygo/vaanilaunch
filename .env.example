# Copy to .env and fill in. NEVER commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5 for the demo; claude-haiku-5-5 while developing to save credits
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high  (medium suits the multi-step launch; low is cheaper)
ANTHROPIC_EFFORT=medium

# --- GoDaddy API (developer.godaddy.com -> API Keys, Production) ---
# Optional locally: without keys the agent reports that domain search is unavailable.
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_API_BASE=https://api.godaddy.com

# --- Your platform domain + VPS public IP ---
# Leave ROOT_DOMAIN and SERVER_IP EMPTY when running locally: stores are then served at
# http://localhost:8000/s/<slug>. Set them only on the VPS.
ROOT_DOMAIN=
SERVER_IP=
ACME_EMAIL=hello@yourdomain.in

# --- Titan / GoDaddy mailbox (SMTP) ---
# Optional locally: without them orders still work, emails are skipped and logged.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# --- Cost & abuse controls ---
MAX_CLAUDE_CALLS_PER_DAY=600
MAX_CLAUDE_CALLS_PER_IP_PER_DAY=150
AGENT_REQUESTS_PER_HOUR_PER_IP=60
MAX_TURNS_PER_SESSION=40
