# Copy to .env and fill in. NEVER commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5 for the demo; claude-haiku-5-5 while developing to save credits
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high  (medium suits the multi-step launch; low is cheaper)
ANTHROPIC_EFFORT=medium

# --- Model routing: Claude is the main model; a free model can back it up ---
# LLM_PROVIDER: claude | free   (free = run everything on the free model, e.g. local testing)
LLM_PROVIDER=claude
# LLM_FALLBACK: none | free     (free = if Claude fails or is out of credits, the free model takes over)
LLM_FALLBACK=free

# --- Free model: any OpenAI-compatible chat API. Pick ONE block. Check the provider's current
# --- free model names; they change often.
# Google Gemini free tier (aistudio.google.com -> Get API key): strong in Indian languages, vision, tools
FREE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FREE_LLM_API_KEY=
FREE_LLM_MODEL=gemini-2.5-flash
# Groq free tier (console.groq.com -> API Keys):
# FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FREE_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Local Ollama, fully offline, no key (ollama.com; then `ollama pull qwen2.5vl:7b`):
# FREE_LLM_BASE_URL=http://localhost:11434/v1
# FREE_LLM_MODEL=qwen2.5vl:7b

# --- Voice: Sarvam AI speech-to-text (dashboard.sarvam.ai -> API keys; Rs 100 free credit) ---
# Optional: empty = the browser's own speech recognition. With a key, the phone records with
# noise suppression and Sarvam transcribes Indian languages and local names far better.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# Daily cap on transcriptions (each clip is at most 30 s), so free credit lasts
MAX_TRANSCRIBE_PER_DAY=500

# --- Product pictures (OpenRouter Image API) for products without a photo ---
# Uses OPENROUTER_API_KEY unless IMAGE_API_KEY is set. No key = dish icons instead.
# OpenRouter only charges prepaid credit: with no credit, a non-free request is refused, not billed.
IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free
MAX_IMAGES_PER_DAY=60

# --- GoDaddy API (developer.godaddy.com -> API Keys, Production) ---
# Optional locally: without keys the agent reports that domain search is unavailable.
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_API_BASE=https://api.godaddy.com

# --- Your platform domain + VPS public IP ---
# Leave ROOT_DOMAIN and SERVER_IP EMPTY when running locally: stores are then served at
# http://localhost:8000/s/<slug>. Set them only on the VPS.
ROOT_DOMAIN=
SERVER_IP=
ACME_EMAIL=hello@yourdomain.in

# --- Titan Business Email (SMTP): a mailbox on YOUR domain, e.g. orders@yourdomain.in ---
# Optional locally: without them orders still work, emails are skipped and logged.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# --- Cost & abuse controls ---
MAX_CLAUDE_CALLS_PER_DAY=600
MAX_CLAUDE_CALLS_PER_IP_PER_DAY=150
AGENT_REQUESTS_PER_HOUR_PER_IP=60
MAX_TURNS_PER_SESSION=40

# --- Abuse and privacy controls (defaults are sensible) ---
# Share of the daily AI budget new visitors may use; the rest is kept for existing store owners
NEW_VISITOR_BUDGET_SHARE=0.8
# Proof-of-work difficulty for a new visitor's first message (0 turns it off)
POW_BITS=16
# Remove customer name/phone/note from orders older than this many days
ORDER_PII_DAYS=90
# Delete uploaded photos no store uses after this many hours
ORPHAN_UPLOAD_HOURS=24
